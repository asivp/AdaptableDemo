{
  "name": "gridtest",
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!((alasql)|(@mui/x-date-pickers/node/AdapterDateFns)))/"
    ],
    "coverageReporters": [
      "cobertura",
      "lcov",
      "html",
      "text-summary"
    ],
    "coveragePathIgnorePatterns": [
      "./src/ComponentRendering/HeaderRender.tsx"
    ],
    "moduleNameMapper": {
      "react-quill/dist/quill.snow.css": "<rootDir>/src/Component/IvpSummernote/TestUtils/summernoteMockComponent"
    }
  },
  "version": "#{VERSION}#",
  "private": false,
  "dependencies": {
    "@adaptabletools/adaptable-react-aggrid-cjs": "19.2.1",
    "@ckeditor/ckeditor5-basic-styles": "^40.2.0",
    "@ckeditor/ckeditor5-build-classic": "^40.2.0",
